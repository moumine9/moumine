{
  "private": true,
  "name": "moumine9",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch:projects": "node scripts/fetch-projects.mjs",
    "render:case-studies": "node scripts/render-case-studies.mjs",
    "prebuild:data": "npm run fetch:projects && npm run render:case-studies",
    "build": "npm run prebuild:data && npx yaml2json src/data --pretty --save --recursive && vite build",
    "dev": "npm run prebuild:data && npx yaml2json src/data --pretty --save --recursive && vite",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "jest"
  },
  "eslintConfig": {
    "extends": "preact"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-brands-svg-icons": "^6.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@preact/signals": "^1.1.2",
    "dayjs": "^1.11.7",
    "lodash": "^4.18.1",
    "preact": "^10.19.5",
    "preact-iso": "^2.4.0",
    "preact-render-to-string": "^6.3.1",
    "preact-router": "^3.2.1",
    "usehooks-ts": "^3.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.5.0",
    "@types/enzyme": "^3.10.12",
    "@types/jest": "^27.4.1",
    "@types/lodash": "^4.14.189",
    "enzyme": "^3.11.0",
    "enzyme-adapter-preact-pure": "^4.0.1",
    "eslint": "^8.56.0",
    "eslint-config-preact": "^1.3.0",
    "jest": "^27.5.1",
    "jest-preset-preact": "^4.0.5",
    "sirv-cli": "^2.0.2",
    "typescript": "^4.9.5",
    "vite": "^4.3.2"
  },
  "jest": {
    "preset": "jest-preset-preact",
    "setupFiles": [
      "<rootDir>/tests/__mocks__/browserMocks.ts",
      "<rootDir>/tests/__mocks__/setupTests.ts"
    ]
  }
}
